{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/atlante/schema/snapshot.schema.json",
  "title": "Atlante del Capitalismo Italiano (Atlas of Italian Capitalism) — Snapshot",
  "type": "object",
  "required": ["meta", "sources", "locations", "sectors", "logos", "nodes", "ownerships", "family_links"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "snapshot_date", "currency", "value_unit", "dataset_status"],
      "properties": {
        "snapshot_date": {"type": "string", "format": "date"}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "publisher", "url"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "url": {"type": "string", "format": "uri"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "category", "subtype", "description", "value_eur_bn", "value_basis", "location_id", "sectors", "source_id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "category": {"enum": ["subject", "organization"]},
          "value_eur_bn": {"type": ["number", "null"], "minimum": 0},
          "location_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "sectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}
        }
      }
    },
    "ownerships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner_id", "owned_id", "percentage", "note", "source_id"],
        "properties": {"percentage": {"type": "number", "minimum": 0, "maximum": 100}}
      }
    },
    "family_links": {"type": "array"},
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "city", "region", "country_code", "latitude", "longitude"]
      }
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "order_index"]
      }
    },
    "logos": {"type": "object"}
  }
}
